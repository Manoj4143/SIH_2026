{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Backend (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    },
    {
      "name": "ML: Run Thunderstorm Training Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml/pipelines/train_thunderstorm.py",
      "cwd": "${workspaceFolder}/ml",
      "console": "integratedTerminal"
    },
    {
      "name": "ML: Run Lightning Training Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ml/pipelines/train_lightning.py",
      "cwd": "${workspaceFolder}/ml",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": [
        "FastAPI: Backend (Uvicorn)",
        "Frontend: Vite Dev Server"
      ]
    }
  ]
}
