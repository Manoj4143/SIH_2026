# =====================================================================
# AI Weather Nowcast - Environment Configuration
# =====================================================================

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Settings
DATABASE_URL=sqlite:///./database/weather_nowcast.db

# AI/ML Model Paths
MODEL_DIR=./models
THUNDERSTORM_MODEL_NAME=thunderstorm_xgb_v1.joblib
LIGHTNING_MODEL_NAME=lightning_xgb_v1.joblib

# Atmospheric Observation Feeds
ENABLE_MOCK_RADAR_FEED=true
RADAR_UPDATE_INTERVAL_SECONDS=300
LIGHTNING_UPDATE_INTERVAL_SECONDS=60
